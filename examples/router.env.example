# Copy to ~/.agent-router/.env, keep it private, and replace the paths/model.
# Required operator decisions; these are examples, not program defaults.
AGENT_ROUTER_CONCURRENCY_CAP=3
AGENT_ROUTER_ATTEMPT_TIMEOUT_SECONDS=600
AGENT_ROUTER_MAX_ATTEMPTS=3
AGENT_ROUTER_OPENCODE_COMMAND='["opencode"]'
AGENT_ROUTER_MODELS='{"glm":"openrouter/<your-exact-configured-model-id>"}'
AGENT_ROUTER_REPOSITORIES='{"/absolute/path/to/your/repository":{"setup_command":"python3 -m venv .venv && .venv/bin/python -m pip install -e ."}}'

# For npm repositories, use the repository's normal setup command, e.g. npm ci.
# Provider variables in this same file are passed to the child environment.
# OPENROUTER_API_KEY=...

# Optional transport/state paths. Keep state outside every parent worktree.
# AGENT_ROUTER_STATE_DIR=~/.agent-router
# AGENT_ROUTER_SOCKET=~/.agent-router/router.sock
