# Copy to ~/.agent-router/.env, keep it private, and replace the paths/model.
# Required operator decisions; these are examples, not program defaults.
AGENT_ROUTER_CONCURRENCY_CAP=3
AGENT_ROUTER_ATTEMPT_TIMEOUT_SECONDS=600
AGENT_ROUTER_MAX_ATTEMPTS=3
AGENT_ROUTER_OPENCODE_COMMAND='["opencode"]'
AGENT_ROUTER_MODELS='{"glm":"openrouter/<your-exact-configured-model-id>"}'
AGENT_ROUTER_REPOSITORIES='{"/absolute/path/to/your/repository":{"setup_command":"python3 -m venv .venv && .venv/bin/python -m pip install -e ."}}'

# For npm repositories, use the repository's normal setup command, e.g. npm ci.
# Provider variables in this same file are passed to the child environment.
# OPENROUTER_API_KEY=...

# Optional transport/state paths. Keep state outside every parent worktree.
# AGENT_ROUTER_STATE_DIR=~/.agent-router
# AGENT_ROUTER_SOCKET=~/.agent-router/router.sock
# AGENT_ROUTER_PROCESS_SAMPLE_INTERVAL_SECONDS=5

# Optional per-model API-equivalent USD / million-token price overrides.
# Native Claude observations otherwise use the dated catalog in router/pricing.py.
# Each list begins at above_input_tokens=0; later tiers apply above that threshold.
# Supply the provider's actual rates; unknown models are not priced by guessing.
# AGENT_ROUTER_MODEL_PRICES='{"exact-model-id":[{"input":1,"output":5,"cache_read":0.1,"cache_write_5m":1.25,"cache_write_1h":2}]}'

# Codex alternative (or configure both executor commands). Use the CLI's saved login;
# Router provider key/endpoint overrides are not forwarded to Codex.
# AGENT_ROUTER_CODEX_COMMAND='["codex"]'
# AGENT_ROUTER_MODELS='{"codex":"openai/<your-exact-model-id>"}'
# AGENT_ROUTER_REPOSITORIES='{"/absolute/path/to/your/repository":{"setup_command":"true","codex_sandbox":"workspace-write"}}'
# Codex estimates input/cache-read/cache-write/output at standard short-context rates.
# Missing usage/rates stay unknown. Tool fees and long-context premiums are excluded.
# Override an exact openai/model-id with one flat tier and cache_write rate;
# aggregate CLI usage cannot choose between per-request context price tiers.
