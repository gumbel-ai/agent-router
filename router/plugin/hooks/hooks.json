{
  "hooks": {
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" submit", "timeout": 20}]}],
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" authorize", "timeout": 20}]},
      {"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" observe", "timeout": 2}]}
    ],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" observe", "timeout": 2}]}],
    "PostToolUseFailure": [{"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" observe", "timeout": 2}]}],
    "SubagentStart": [{"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" observe", "timeout": 2}]}],
    "SubagentStop": [{"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" observe", "timeout": 2}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hook.sh\" observe", "timeout": 2}]}]
  }
}
