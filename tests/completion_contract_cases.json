{
  "schema_version": 1,
  "cases": [
    {"name": "missing-file", "contract": {"files": ["answer.txt"]}, "files": {}, "expected": "violated"},
    {"name": "invalid-json", "contract": {"json_files": ["answer.json"]}, "files": {"answer.json": "{"}, "expected": "violated"},
    {"name": "valid-json", "contract": {"json_files": ["answer.json"]}, "files": {"answer.json": "{\"value\": 1}"}, "expected": "satisfied"},
    {"name": "optional-omission", "contract": {"files": []}, "files": {}, "expected": "satisfied"},
    {"name": "explicit-setup-failure", "contract": {"setup_status_file": "setup.json"}, "files": {"setup.json": "{\"status\": \"SETUP_FAILED\"}"}, "expected": "violated"},
    {"name": "setup-ready", "contract": {"setup_status_file": "setup.json"}, "files": {"setup.json": "{\"status\": \"READY\"}"}, "expected": "satisfied"},
    {"name": "unknown-setup-status", "contract": {"setup_status_file": "setup.json"}, "files": {"setup.json": "{\"status\": \"UNKNOWN\"}"}, "expected": "unknown"},
    {"name": "optional-empty-final", "contract": {"final_response": false}, "files": {}, "final_response_present": false, "expected": "satisfied"},
    {"name": "required-empty-final", "contract": {"final_response": true}, "files": {}, "final_response_present": false, "expected": "violated"},
    {"name": "required-present-final", "contract": {"final_response": true}, "files": {}, "final_response_present": true, "expected": "satisfied"},
    {"name": "undeclared-success", "contract": null, "files": {}, "expected": "not_declared"}
  ]
}
